TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
PORT=3000
DATABASE_URL=file:./cctv.db

# Ruta a ffmpeg/ffprobe. Si se omite, se busca FFMPEG_PATH, PATH y la instalación de WinGet.
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
# FFPROBE_PATH=C:\ruta\a\ffprobe.exe

# Clave de 32 bytes (hex de 64 caracteres o base64) para cifrar contraseñas de cámaras.
# Si se omite, se genera .credentials-key en la carpeta del servidor.
# CREDENTIALS_KEY=
# CREDENTIALS_KEY_FILE=./.credentials-key

# Intervalo del monitor de salud en milisegundos (por defecto 30000).
# HEALTH_INTERVAL_MS=30000

# Webhooks genéricos separados por comas. Se envían al crear alertas.
# WEBHOOK_URL=https://example.com/hooks/cctv
# Secreto opcional para firmar el cuerpo con HMAC-SHA256 (cabecera X-CCTV-Signature).
# WEBHOOK_SECRET=change-me
# WEBHOOK_TIMEOUT_MS=5000
